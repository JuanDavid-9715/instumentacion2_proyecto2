# Local (SQLite por defecto, no PG ni Docker)
SECRET_KEY=django-insecure-dev-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Vacío = SQLite en software/db.sqlite3
# DATABASE_URL=

# Producción Render (F13, Postgres managed + Redis) — en el dashboard de Render:
# DATABASE_URL=postgresql://... (la pone Render: fromDatabase)
# REDIS_URL=redis://... (la pone Render: fromService keyvalue)
# SECRET_KEY=valor-largo-aleatorio (generateValue)
# DEBUG=False
# ALLOWED_HOSTS=tu-app.onrender.com (+ RENDER_EXTERNAL_HOSTNAME automático)
# MQTT_HOST/MQTT_PORT/MQTT_USER/MQTT_PASS (sync:false: los rellenas tú)

# MQTT HiveMQ (F5) — mismos de Access Management, solo en .env local:
# MQTT_HOST=xxxx.s1.eu.hivemq.cloud
# MQTT_PORT=8883
# MQTT_USER=xxxx
# MQTT_PASS=xxxx

# Redis (F13 Render Key Value) — vacío = InMemory local:
# REDIS_URL=redis://localhost:6379/0

# Ingesta autostart (F5 unificado): 1 = Daphne/runserver también guardan MQTT.
# 0 = solo comando manual listen_mqtt.
# INGESTA_AUTOSTART=1
