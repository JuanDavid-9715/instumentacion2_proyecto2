# Local (SQLite por defecto, no PG ni Docker)
SECRET_KEY=django-insecure-dev-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Vacío = SQLite en software/db.sqlite3
# DATABASE_URL=

# Producción Render (F13, Postgres managed) — solo en el dashboard de Render:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# SECRET_KEY=valor-largo-aleatorio
# DEBUG=False
# ALLOWED_HOSTS=tu-app.onrender.com

# MQTT HiveMQ (F5) — mismos de Access Management, solo en .env local:
# MQTT_HOST=xxxx.s1.eu.hivemq.cloud
# MQTT_PORT=8883
# MQTT_USER=xxxx
# MQTT_PASS=xxxx
